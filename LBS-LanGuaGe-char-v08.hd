#include "asr.h"
extern "C"{ void * __dso_handle = 0 ;}
#include "setup.h"
#include "HardwareSerial.h"
#include "myLib/asr_event.h"

//{speak:小蝶-清新女声,vol:10,speed:10,platform:haohaodada}

// ============================================================
// 小白-Ai UART 协议 v0.8 (ASRPRO 端 · 字符编程)
// MCU → ASR: play=<id>\n / stop\n / ping\n     (id: 17-63)
// ASR → MCU: cmd=<id>\r\n / wake\r\n / sleep\r\n / done=<id>\r\n
//   cmd id: 1-16 与 42-51 (ASR_01–ASR_10), wake 对应识别 ID=0
// ★ 本文件的 //{ID:..} 与 //{playid:..} 注释就是"模型定义"，
//   在字符编程模式下点"生成模型"才会按这里重建词条表。
// ============================================================

uint32_t snid;
void app();
void ASR_CODE();

static volatile uint8_t g_playing_id = 0;

static void on_play_done(uint16_t play_id) {
  uint8_t pid = g_playing_id;
  if (pid > 0) {
    char buf[16];
    snprintf(buf, sizeof(buf), "done=%u\r\n", pid);
    Serial1.print(buf);
    g_playing_id = 0;
  }
}

static void trim_frame(String &s) {
  while (s.length() > 0) {
    char c = s.charAt(s.length() - 1);
    if (c == '\r' || c == '\n' || c == ' ' || c == '\t')
      s.remove(s.length() - 1);
    else
      break;
  }
}

static int parse_num(const String &s, const char *prefix) {
  int plen = strlen(prefix);
  if (!s.startsWith(prefix)) return -1;
  if ((int)s.length() <= plen) return -1;
  int val = 0;
  for (int i = plen; i < (int)s.length(); i++) {
    char c = s.charAt(i);
    if (c < '0' || c > '9') return -1;
    val = val * 10 + (c - '0');
    if (val > 255) return -1;
  }
  return val;
}

// UART 接收任务 - 按 \n 精确分帧
void app(){
  while (1) {
    if (Serial1.available() > 0) {
      String frame = Serial1.readStringUntil('\n');
      trim_frame(frame);

      if (frame.length() == 0 || frame.length() > 30) {
        continue;
      }

      // ---- play=<id> ----  id 范围 17-63
      int pid = parse_num(frame, "play=");
      if (pid >= 0) {
        if (pid < 17 || pid > 63) continue;  // 越界丢弃
        g_playing_id = (uint8_t)pid;
        prompt_play_by_voice_id((uint16_t)pid, on_play_done, true);
        continue;
      }

      if (frame == "stop") {
        g_playing_id = 0;
        prompt_stop_play();
        continue;
      }

      if (frame == "ping") {
        continue;
      }
    }
    delay(2);
  }
  vTaskDelete(NULL);
}

// 休眠钩子：上报 sleep，主控据此熄灭呼吸灯
void sys_sleep_hook() {
  Serial1.print("sleep\r\n");
}

void ASR_CODE(){
  set_state_enter_wakeup(15000);

  if (snid == 0) {
    Serial1.print("wake\r\n");
  } else if ((snid >= 1 && snid <= 16) || (snid >= 42 && snid <= 51)) {
    char buf[16];
    snprintf(buf, sizeof(buf), "cmd=%u\r\n", (unsigned)snid);
    Serial1.print(buf);
  }
}

void hardware_init(){
  vol_set(7);
  setPinFun(2,FORTH_FUNCTION);
  setPinFun(3,FORTH_FUNCTION);
  Serial1.begin(9600);
  Serial1.flush();
  xTaskCreate(app,"app",512,NULL,4,NULL);
  vTaskDelete(NULL);
}

